{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodex.example/schemas/session-memory.schema.json",
  "title": "KODEX Session Memory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sessionId", "path", "decisions", "accessibility", "consent"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "sessionId": {"type": "string", "minLength": 1},
    "startedAt": {"type": ["string", "null"]},
    "path": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "sourcesOpened": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "claimsSeen": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "entitiesTraced": {"type": "array", "items": {"type": "string"}},
    "relationsTraced": {"type": "array", "items": {"type": "string"}},
    "contradictionsSeen": {"type": "array", "items": {"type": "string"}},
    "userAnnotations": {"type": "array", "items": {"type": "string"}},
    "systemObservations": {"type": "array", "items": {"type": "string"}},
    "selectedFunctionalState": {"type": ["string", "null"]},
    "contemplativePreferences": {"type": "object"},
    "accessibility": {
      "type": "object",
      "required": ["motion", "sound"],
      "properties": {
        "motion": {"enum": ["FULL", "REDUCED", "OFF"]},
        "sound": {"enum": ["ON", "OFF"]},
        "contrast": {"type": "string"},
        "textScale": {"type": "string"}
      },
      "additionalProperties": true
    },
    "artifactSeed": {"type": ["string", "null"]},
    "generatedArtifacts": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "consent": {"type": "object"}
  }
}
