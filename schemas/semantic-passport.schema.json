{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodex.example/schemas/semantic-passport.schema.json",
  "title": "KODEX Semantic Passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "elementId",
    "sceneId",
    "questionSupported",
    "meaning",
    "channel",
    "uncertaintyBehavior",
    "missingValueBehavior",
    "interactionRole",
    "status"
  ],
  "properties": {
    "elementId": {"type": "string", "minLength": 1},
    "sceneId": {"type": "string", "minLength": 1},
    "questionSupported": {"type": "string", "minLength": 1},
    "sourceFields": {"type": "array", "items": {"type": "string"}},
    "claimIds": {"type": "array", "items": {"type": "string"}},
    "transformationIds": {"type": "array", "items": {"type": "string"}},
    "meaning": {"type": "string", "minLength": 1},
    "channel": {
      "enum": [
        "position",
        "length",
        "angle",
        "direction",
        "area",
        "connection",
        "shape",
        "texture",
        "density",
        "color",
        "opacity",
        "motion",
        "sound",
        "text",
        "atmosphere"
      ]
    },
    "scale": {"enum": ["nominal", "ordinal", "interval", "ratio", "topological", "none"]},
    "legendLabel": {"type": ["string", "null"]},
    "uncertaintyBehavior": {"type": "string", "minLength": 1},
    "missingValueBehavior": {"type": "string", "minLength": 1},
    "interactionRole": {
      "enum": ["REVEAL", "COMPARE", "FILTER", "TRACE", "NAVIGATE", "SIMULATE", "ANNOTATE", "CONTRIBUTE", "ORIENT", "NONE"]
    },
    "status": {"enum": ["ADMITTED", "ATMOSPHERE", "BLOCKED"]},
    "accessibilityAlternative": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
