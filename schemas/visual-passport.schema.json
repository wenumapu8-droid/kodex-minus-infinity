{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodex.example/schemas/visual-passport.schema.json",
  "title": "KODEX Factory Visual Passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passportId",
    "conceptId",
    "title",
    "status",
    "semanticPurpose",
    "nodeQuestion",
    "sourceRefs",
    "provenanceBoundaries",
    "informationHierarchy",
    "geometry",
    "composition",
    "paletteRoles",
    "typographyRoles",
    "motion",
    "interaction",
    "implementation",
    "fallback",
    "accessibility",
    "reviewChecks",
    "epistemicConstraints"
  ],
  "properties": {
    "passportId": {"type": "string", "minLength": 1},
    "conceptId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "REVIEW", "APPROVED", "BLOCKED"]},
    "semanticPurpose": {"type": "string", "minLength": 1},
    "nodeQuestion": {"type": "string", "minLength": 1},
    "coordinateAssignment": {
      "type": ["string", "null"],
      "pattern": "^[A-Y]$"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "relation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "relation": {"enum": ["PRIMARY_CONCEPT", "REFERENCE", "PROVENANCE", "RESEARCH", "DESIGN_SYSTEM"]},
          "rightsStatus": {"type": ["string", "null"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "provenanceBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mayAbstract", "mustNotCopy", "culturalSensitivity"],
      "properties": {
        "mayAbstract": {"type": "array", "items": {"type": "string"}},
        "mustNotCopy": {"type": "array", "items": {"type": "string"}},
        "culturalSensitivity": {"type": "array", "items": {"type": "string"}}
      }
    },
    "informationHierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "tertiary"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "secondary": {"type": "array", "items": {"type": "string"}},
        "tertiary": {"type": "array", "items": {"type": "string"}}
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitives", "topology", "coordinateSystem", "spatialLayers"],
      "properties": {
        "primitives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "topology": {"type": "string", "minLength": 1},
        "coordinateSystem": {"type": "string", "minLength": 1},
        "spatialLayers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focalStructure", "grid", "depthModel", "negativeSpace", "responsiveRules"],
      "properties": {
        "focalStructure": {"type": "string", "minLength": 1},
        "grid": {"type": "string", "minLength": 1},
        "depthModel": {"type": "string", "minLength": 1},
        "negativeSpace": {"type": "string", "minLength": 1},
        "responsiveRules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktop", "mobile"],
          "properties": {
            "desktop": {"type": "string", "minLength": 1},
            "mobile": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "paletteRoles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "semanticMeaning", "tokenOrRange", "colorIsNotOnlyChannel"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "semanticMeaning": {"type": "string", "minLength": 1},
          "tokenOrRange": {"type": "string", "minLength": 1},
          "colorIsNotOnlyChannel": {"type": "boolean"}
        }
      }
    },
    "typographyRoles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "behavior"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "behavior": {"type": "string", "minLength": 1}
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timescales", "stateTransitions", "loopingBehavior", "reducedMotion"],
      "properties": {
        "timescales": {"type": "array", "items": {"type": "string"}},
        "stateTransitions": {"type": "array", "items": {"type": "string"}},
        "loopingBehavior": {"type": "string", "minLength": 1},
        "reducedMotion": {"type": "string", "minLength": 1}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "semanticActions", "stateChanges", "memoryWrite", "exitBehavior"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {"enum": ["POINTER", "TOUCH", "KEYBOARD", "AUDIO_OPTIONAL", "TIME", "NONE"]}
        },
        "semanticActions": {"type": "array", "items": {"type": "string"}},
        "stateChanges": {"type": "array", "items": {"type": "string"}},
        "memoryWrite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "key", "description"],
          "properties": {
            "enabled": {"type": "boolean"},
            "key": {"type": "string"},
            "description": {"type": "string"}
          }
        },
        "exitBehavior": {"type": "string", "minLength": 1}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["medium", "reusableEngineBoundary", "sceneSpecificParts", "dependencies", "performanceRisk"],
      "properties": {
        "medium": {"enum": ["DOM", "SVG", "CANVAS", "WEBGL", "SHADER", "HYBRID"]},
        "reusableEngineBoundary": {"type": "string", "minLength": 1},
        "sceneSpecificParts": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "performanceRisk": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noWebGL", "noAudio", "staticMode"],
      "properties": {
        "noWebGL": {"type": "string", "minLength": 1},
        "noAudio": {"type": "string", "minLength": 1},
        "staticMode": {"type": "string", "minLength": 1}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyboardEquivalent", "touchEquivalent", "screenReaderAlternative", "nonColorEquivalent", "reducedMotionEquivalent"],
      "properties": {
        "keyboardEquivalent": {"type": "string", "minLength": 1},
        "touchEquivalent": {"type": "string", "minLength": 1},
        "screenReaderAlternative": {"type": "string", "minLength": 1},
        "nonColorEquivalent": {"type": "string", "minLength": 1},
        "reducedMotionEquivalent": {"type": "string", "minLength": 1}
      }
    },
    "reviewChecks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "targetCaptures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "width", "height"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1}
        }
      }
    },
    "epistemicConstraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scientificClaimPolicy": {"enum": ["SYMBOLIC_ONLY", "VERIFIED_ONLY", "MIXED_WITH_EXPLICIT_LABELS"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
